# Dev/test target: the isolated LOCAL Supabase stack (supabase start).
# Loaded by `npm run dev` / `npm run build:dev`; production builds read .env.
# The key below is this machine's local-stack publishable key. If it 401s
# (a fresh Docker volume regenerates keys), copy the current values from
#   supabase status -o env
# into .env.development.local (git-ignored) — it overrides this file.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PROJECT_ID=local
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
